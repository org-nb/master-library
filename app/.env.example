# Master Library app environment (ADR-0003/0004/0005).
# Copy to .env for local dev; all values here are placeholders.
# .env is gitignored; real values live in GitHub environment secrets (ADR-0002/0005).

# Origins
APP_ORIGIN=http://localhost:5173
PUBLIC_MEDIA_BASE_URL=http://localhost:8080

# R2 (S3-compatible). The private bucket holds vault notes (vault/ prefix)
# and media; the public bucket holds published playback objects.
S3_ENDPOINT_URL=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=testuser
S3_SECRET_ACCESS_KEY=testpassword
R2_BUCKET_PRIVATE=master-library-media-private-dev
R2_BUCKET_PUBLIC=master-library-media-public-dev
VAULT_PREFIX=vault

# oxivault API (loopback inside the container)
OXIVAULT_BASE_URL=http://127.0.0.1:8000
OXIVAULT_EDITOR_TOKEN=change-me-loopback-editor-token

# Google OIDC (ADR-0005)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Session
SESSION_SECRET=replace-with-32-plus-random-characters-here
SESSION_TTL_MS=43200000

# Allowlist (GitHub environment secrets in deployment)
OAUTH_USER_COUNT=1
OAUTH_USER_1=you@example.org|librarian

# Registries (JSON files)
REGISTRIES_DIR=fixtures/registries

# LLM provider (optional; agent route returns 503 when unset)
# LLM_API_BASE=https://api.example.com/v1
# LLM_API_KEY=
# LLM_MODEL=
